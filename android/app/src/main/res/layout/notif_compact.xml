<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed notification: round icon buttons only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="48dp" android:gravity="center" android:orientation="horizontal">

    <ImageView android:id="@+id/nc_start" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginLeft="6dp" android:layout_marginRight="6dp" android:padding="8dp" android:scaleType="fitCenter" android:visibility="gone" />
    <ImageView android:id="@+id/nc_off" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginLeft="6dp" android:layout_marginRight="6dp" android:padding="8dp" android:scaleType="fitCenter" android:visibility="gone" />
    <ImageView android:id="@+id/nc_toggle" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginLeft="6dp" android:layout_marginRight="6dp" android:padding="8dp" android:scaleType="fitCenter" />
    <ImageView android:id="@+id/nc_lock" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginLeft="6dp" android:layout_marginRight="6dp" android:padding="8dp" android:scaleType="fitCenter" />
    <ImageView android:id="@+id/nc_reset" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginLeft="6dp" android:layout_marginRight="6dp" android:padding="8dp" android:scaleType="fitCenter" />
    <ImageView android:id="@+id/nc_open" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginLeft="6dp" android:layout_marginRight="6dp" android:padding="8dp" android:scaleType="fitCenter" />
    <ImageView android:id="@+id/nc_stop" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginLeft="6dp" android:layout_marginRight="6dp" android:padding="8dp" android:scaleType="fitCenter" />
</LinearLayout>
